{
  "name": "mylocalon",
  "version": "0.1.1",
  "description": "mylocalon CLI — expose localhost over a public URL",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mylocalon": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@mylocalon/sdk-node": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "homepage": "https://mylocalon.com",
  "keywords": [
    "tunnel",
    "localhost",
    "ngrok-alternative",
    "webhooks",
    "dev-tools"
  ]
}
